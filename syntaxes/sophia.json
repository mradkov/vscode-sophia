{
    "fileTypes": [
        "aes"
    ],
    "name": "Sophia",
    "patterns": [
        {
            "include": "#natspec"
        },
        {
            "include": "#comment"
        },
        {
            "include": "#pragma"
        },
        {
            "include": "#include-directive"
        },
        {
            "include": "#alias"
        },
        {
            "include": "#string"
        },
        {
            "include": "#char"
        },
        {
            "include": "#type-variable"
        },
        {
            "include": "#declaration"
        },
        {
            "include": "#literal"
        },
        {
            "include": "#type"
        },
        {
            "include": "#global"
        },
        {
            "include": "#control"
        },
        {
            "include": "#operator"
        },
        {
            "include": "#function-call"
        },
        {
            "include": "#constructor"
        },
        {
            "include": "#punctuation"
        }
    ],
    "repository": {
        "natspec": {
            "patterns": [
                {
                    "begin": "/\\*\\*(?!/)",
                    "end": "\\*/",
                    "name": "comment.block.documentation.sophia",
                    "patterns": [
                        {
                            "include": "#natspec-tags"
                        },
                        {
                            "include": "#comment-block"
                        }
                    ]
                },
                {
                    "begin": "///",
                    "end": "$",
                    "name": "comment.block.documentation.sophia",
                    "patterns": [
                        {
                            "include": "#natspec-tags"
                        }
                    ]
                }
            ]
        },
        "natspec-tags": {
            "patterns": [
                {
                    "include": "#natspec-tag-title"
                },
                {
                    "include": "#natspec-tag-author"
                },
                {
                    "include": "#natspec-tag-notice"
                },
                {
                    "include": "#natspec-tag-dev"
                },
                {
                    "include": "#natspec-tag-param"
                },
                {
                    "include": "#natspec-tag-return"
                }
            ]
        },
        "natspec-tag-title": {
            "match": "(@title)\\b",
            "name": "storage.type.title.natspec"
        },
        "natspec-tag-author": {
            "match": "(@author)\\b",
            "name": "storage.type.author.natspec"
        },
        "natspec-tag-notice": {
            "match": "(@notice)\\b",
            "name": "storage.type.dev.natspec"
        },
        "natspec-tag-dev": {
            "match": "(@dev)\\b",
            "name": "storage.type.dev.natspec"
        },
        "natspec-tag-param": {
            "match": "(@param)(\\s+([A-Za-z_][A-Za-z0-9_']*))?\\b",
            "captures": {
                "1": {
                    "name": "storage.type.param.natspec"
                },
                "3": {
                    "name": "variable.other.natspec"
                }
            }
        },
        "natspec-tag-return": {
            "match": "(@return)\\b",
            "name": "storage.type.return.natspec"
        },
        "comment": {
            "patterns": [
                {
                    "include": "#comment-line"
                },
                {
                    "include": "#comment-block"
                }
            ]
        },
        "comment-line": {
            "match": "(?<!tp:)(//).*$",
            "name": "comment.line.double-slash.sophia",
            "captures": {
                "1": {
                    "name": "punctuation.definition.comment.sophia"
                }
            }
        },
        "comment-block": {
            "begin": "/\\*",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.definition.comment.begin.sophia"
                }
            },
            "end": "\\*/",
            "endCaptures": {
                "0": {
                    "name": "punctuation.definition.comment.end.sophia"
                }
            },
            "name": "comment.block.sophia",
            "patterns": [
                {
                    "include": "#comment-block"
                }
            ]
        },
        "operator": {
            "patterns": [
                {
                    "include": "#operator-word"
                },
                {
                    "include": "#operator-arrow"
                },
                {
                    "include": "#operator-list"
                },
                {
                    "include": "#operator-logic"
                },
                {
                    "include": "#operator-binary"
                },
                {
                    "include": "#operator-arithmetic"
                },
                {
                    "include": "#operator-assignment"
                }
            ]
        },
        "operator-word": {
            "match": "\\b(mod|band|bor|bxor|bnot)\\b",
            "name": "keyword.operator.word.sophia"
        },
        "operator-arrow": {
            "match": "(\\|>|=>|->|<-|\\.\\.)",
            "name": "keyword.operator.arrow.associative.sophia"
        },
        "operator-list": {
            "match": "(::|\\+\\+)",
            "name": "keyword.operator.list.sophia"
        },
        "operator-logic": {
            "match": "(==|!=|=<|>=|<|>|&&|\\|\\||!)",
            "name": "keyword.operator.logic.sophia"
        },
        "operator-binary": {
            "match": "(<<|>>)",
            "name": "keyword.operator.binary.sophia"
        },
        "operator-arithmetic": {
            "match": "(\\+|\\-|\\/|\\*|\\^)",
            "name": "keyword.operator.arithmetic.sophia"
        },
        "operator-assignment": {
            "match": "(=|@|:|\\|)",
            "name": "keyword.operator.assignment.sophia"
        },
        "control": {
            "patterns": [
                {
                    "include": "#control-flow"
                },
                {
                    "include": "#control-keywords"
                },
                {
                    "include": "#control-modifiers"
                },
                {
                    "include": "#control-underscore"
                }
            ]
        },
        "control-flow": {
            "match": "\\b(if|elif|else|switch|let)\\b",
            "name": "keyword.control.flow.sophia"
        },
        "control-keywords": {
            "match": "\\b(contract|interface|namespace|record|datatype|type|entrypoint|function|main|using|as|for|hiding|include)\\b",
            "name": "keyword.control.keywords.sophia"
        },
        "control-modifiers": {
            "match": "\\b(stateful|payable|private|public|indexed)\\b",
            "name": "storage.modifier.sophia"
        },
        "control-underscore": {
            "match": "\\b(_)\\b",
            "name": "constant.other.underscore.sophia"
        },
        "pragma": {
            "match": "(@compiler)(?:\\s*(==|=<|>=|<|>))?(?:\\s*(\\d+(?:\\.\\d+)*))?",
            "captures": {
                "1": {
                    "name": "keyword.control.pragma.sophia"
                },
                "2": {
                    "name": "keyword.operator.comparison.pragma.sophia"
                },
                "3": {
                    "name": "constant.numeric.version.pragma.sophia"
                }
            }
        },
        "include-directive": {
            "match": "\\b(include)\\b",
            "name": "keyword.control.import.sophia"
        },
        "literal": {
            "patterns": [
                {
                    "include": "#bytes-literal"
                },
                {
                    "include": "#number-hex"
                },
                {
                    "include": "#number-decimal"
                },
                {
                    "include": "#chain-literal"
                },
                {
                    "include": "#constant-boolean"
                }
            ]
        },
        "bytes-literal": {
            "match": "#[0-9a-fA-F]+(?:_[0-9a-fA-F]+)*\\b",
            "name": "constant.numeric.bytes.sophia"
        },
        "number-decimal": {
            "match": "\\b[0-9]+(?:_[0-9]+)*\\b",
            "name": "constant.numeric.decimal.sophia"
        },
        "number-hex": {
            "match": "\\b0[xX][0-9a-fA-F]+(?:_[0-9a-fA-F]+)*\\b",
            "name": "constant.numeric.hexadecimal.sophia"
        },
        "chain-literal": {
            "match": "\\b(?:ak|ct|ok|oq|sg|nm|ch|cb|th)_[1-9A-HJ-NP-Za-km-z]+\\b",
            "name": "constant.other.address.sophia"
        },
        "constant-boolean": {
            "match": "\\b(true|false)\\b",
            "name": "constant.language.boolean.sophia"
        },
        "string": {
            "begin": "\"",
            "end": "\"",
            "name": "string.quoted.double.sophia",
            "patterns": [
                {
                    "match": "\\\\(?:[befnrtv\\\\\"']|x[0-9a-fA-F]{2}|x\\{[0-9a-fA-F]+\\})",
                    "name": "constant.character.escape.sophia"
                }
            ]
        },
        "char": {
            "match": "'(?:\\\\[befnrtv\\\\'\"]|\\\\x[0-9a-fA-F]{2}|\\\\x\\{[0-9a-fA-F]*\\}|[^'\\\\\\n])'",
            "name": "string.quoted.single.sophia"
        },
        "type-variable": {
            "match": "'[a-z_][A-Za-z0-9_']*(?!')",
            "name": "storage.type.generic.sophia"
        },
        "type": {
            "patterns": [
                {
                    "include": "#type-qualified"
                },
                {
                    "include": "#type-primitive"
                }
            ]
        },
        "type-qualified": {
            "match": "\\b(Chain\\.ttl|AENS\\.pointee|AENS\\.name|AENSv2\\.pointee|AENSv2\\.name|MCL_BLS12_381\\.fr|MCL_BLS12_381\\.fp)\\b",
            "name": "support.type.builtin.sophia"
        },
        "type-primitive": {
            "match": "\\b(int|address|bool|bits|bytes|string|list|option|char|unit|map|event|hash|signature|oracle|oracle_query)\\b",
            "name": "support.type.primitive.sophia"
        },
        "global": {
            "patterns": [
                {
                    "include": "#global-exceptions"
                },
                {
                    "include": "#global-builtins"
                },
                {
                    "include": "#global-constructors"
                },
                {
                    "include": "#global-namespaces"
                }
            ]
        },
        "global-exceptions": {
            "match": "\\b(require|abort|exit)\\b",
            "name": "keyword.control.exceptions.sophia"
        },
        "global-builtins": {
            "match": "\\b(put|state)\\b",
            "name": "support.function.builtin.sophia"
        },
        "global-constructors": {
            "match": "\\b(Some|None|RelativeTTL|FixedTTL)\\b",
            "name": "constant.language.constructor.sophia"
        },
        "global-namespaces": {
            "match": "\\b(Chain|Address|Bits|Bytes|Call|Char|Contract|Crypto|Int|List|Map|Option|Oracle|String|AENS|AENSv2|Auth|BLS12_381|MCL_BLS12_381|Frac|Func|Pair|Triple|Set|Bitwise)\\b",
            "name": "variable.language.namespace.sophia"
        },
        "declaration": {
            "patterns": [
                {
                    "include": "#declaration-contract"
                },
                {
                    "include": "#declaration-namespace"
                },
                {
                    "include": "#declaration-type"
                },
                {
                    "include": "#declaration-function"
                }
            ]
        },
        "declaration-contract": {
            "match": "\\b(?:(payable)\\s+)?(?:(main)\\s+)?(contract)(?:\\s+(interface))?(?:\\s+([A-Z][A-Za-z0-9_']*))?\\b",
            "captures": {
                "1": {
                    "name": "storage.modifier.payable.sophia"
                },
                "2": {
                    "name": "storage.modifier.main.sophia"
                },
                "3": {
                    "name": "storage.type.contract.sophia"
                },
                "4": {
                    "name": "storage.type.interface.sophia"
                },
                "5": {
                    "name": "entity.name.type.contract.sophia"
                }
            }
        },
        "declaration-namespace": {
            "match": "\\b(namespace)(?:\\s+([A-Z][A-Za-z0-9_']*))?\\b",
            "captures": {
                "1": {
                    "name": "storage.type.namespace.sophia"
                },
                "2": {
                    "name": "entity.name.type.namespace.sophia"
                }
            }
        },
        "declaration-type": {
            "match": "\\b(record|datatype|type)(?:\\s+([a-z_][A-Za-z0-9_']*))?\\b",
            "captures": {
                "1": {
                    "name": "storage.type.sophia"
                },
                "2": {
                    "name": "entity.name.type.sophia"
                }
            }
        },
        "declaration-function": {
            "match": "\\b(?:(payable|stateful|private|public)\\s+)?(?:(payable|stateful|private|public)\\s+)?(entrypoint|function)(?:\\s+([a-z_][A-Za-z0-9_']*))?\\b",
            "captures": {
                "1": {
                    "name": "storage.modifier.sophia"
                },
                "2": {
                    "name": "storage.modifier.sophia"
                },
                "3": {
                    "name": "storage.type.function.sophia"
                },
                "4": {
                    "name": "entity.name.function.sophia"
                }
            }
        },
        "function-call": {
            "match": "\\b([a-z_][A-Za-z0-9_']*)\\s*(?=\\()",
            "captures": {
                "1": {
                    "name": "entity.name.function.sophia"
                }
            }
        },
        "constructor": {
            "match": "\\b([A-Z][A-Za-z0-9_']*)\\b",
            "name": "entity.name.tag.constructor.sophia"
        },
        "punctuation": {
            "patterns": [
                {
                    "match": ";",
                    "name": "punctuation.terminator.statement.sophia"
                },
                {
                    "match": "\\.",
                    "name": "punctuation.accessor.sophia"
                },
                {
                    "match": ",",
                    "name": "punctuation.separator.sophia"
                },
                {
                    "match": "[(){}\\[\\]]",
                    "name": "punctuation.brackets.sophia"
                }
            ]
        },
        "alias": {
            "patterns": [
                {
                    "match": "\\b(using)\\s+([A-Z][A-Za-z0-9_']*)(?:\\s+(as)\\s+([A-Z][A-Za-z0-9_']*))?(?:\\s+(for|hiding))?\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.import.sophia"
                        },
                        "2": {
                            "name": "entity.name.namespace.sophia"
                        },
                        "3": {
                            "name": "keyword.control.import.sophia"
                        },
                        "4": {
                            "name": "entity.name.namespace.sophia"
                        },
                        "5": {
                            "name": "keyword.control.import.sophia"
                        }
                    }
                }
            ]
        }
    },
    "scopeName": "source.sophia",
    "uuid": "ad87d2cd-8575-4afe-984e-9421a3788933"
}
